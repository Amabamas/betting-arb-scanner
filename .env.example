# --- Authenticated venues (optional; venue is skipped if its key is missing) ---

# Kalshi (RSA-signed requests)
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PEM=

# Cloudbet (Feed API key, X-API-Key header)
CLOUDBET_API_KEY=

# PS3838 (HTTP Basic Auth, requires funded account)
PS3838_USERNAME=
PS3838_PASSWORD=

# Overtime Markets V2 (x-api-key header)
OVERTIME_API_KEY=

# --- Scanner config ---

# Comma-separated list of adapter ids to enable. Empty = all known.
SCANNER_VENUES=
SCANNER_DOMAIN=hybrid          # sport | prediction | hybrid
SCANNER_INTERVAL_S=15
SCANNER_MIN_ROI=0.005          # 0.5% minimum arb edge to display
SCANNER_MIN_LIQUIDITY_USD=50
SCANNER_TIME_WINDOW_HOURS=2    # max start-time delta when matching events
SCANNER_TITLE_THRESHOLD=82     # rapidfuzz token_set_ratio threshold (0-100)
SCANNER_MAX_OPPS=40
SCANNER_LOG_LEVEL=INFO
